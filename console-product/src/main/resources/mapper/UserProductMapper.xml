<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.console.product.mapper.UserProductMapper">
    <insert id="replaceBatchUserProduct">
        REPLACE INTO r_user_product (user_id, product_id, type, update_time) values
        <foreach collection="userProducts" item="item" separator=",">
            (#{item.userId},#{item.productId},#{item.type},#{item.updateTime})
        </foreach>
    </insert>
</mapper>